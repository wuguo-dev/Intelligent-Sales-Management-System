<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.haowugou</groupId>
        <artifactId>haowugou</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>haowugou-bootstrap</artifactId>
    <name>haowugou-bootstrap</name>
    <description>启动/组装模块：唯一入口、REST 接口、定时任务、配置</description>

    <dependencies>
        <dependency>
            <groupId>com.haowugou</groupId>
            <artifactId>haowugou-application</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 启动模块是唯一组装点，在此选择具体 Adapter -->
        <dependency>
            <groupId>com.haowugou</groupId>
            <artifactId>haowugou-infrastructure</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.haowugou</groupId>
            <artifactId>haowugou-agent</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.xuxueli</groupId>
            <artifactId>xxl-job-core</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
