# 本地开发配置模板（复制为 application-local.yml 并填写真实凭据）
#
# 使用方式：
#   1. cp application-local.yml.example application-local.yml
#   2. 将 password / api-key 替换为本地 MySQL 密码和 DashScope API Key
# application-local.yml 已被 .gitignore 忽略，不会进入 Git 历史。
spring:
  datasource:
    url: jdbc:mysql://127.0.0.1:3306/haowugou?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: root
    password: your_mysql_password
    driver-class-name: com.mysql.cj.jdbc.Driver
  ai:
    dashscope:
      api-key: your_dashscope_api_key

mybatis-plus:
  configuration:
    map-underscore-to-camel-case: true